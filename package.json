{
  "name": "cutly",
  "productName": "Cutly",
  "version": "0.1.0",
  "private": true,
  "description": "Cutly - free desktop video editor",
  "author": "Garzi71",
  "homepage": "https://github.com/Garzi71/cutlyeditor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Garzi71/cutlyeditor.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never",
    "release": "npm version patch -m \"Release %s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Release %s\" && git push --follow-tags"
  },
  "build": {
    "appId": "com.garzi71.cutly",
    "productName": "Cutly",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Cutly-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cutly"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Garzi71",
        "repo": "cutlyeditor",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "immer": "^11.2.10",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
